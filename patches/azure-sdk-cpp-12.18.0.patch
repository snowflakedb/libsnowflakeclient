diff --git a/cmake-modules/AzureHonorCxxStandard.cmake b/cmake-modules/AzureHonorCxxStandard.cmake
new file mode 100644
index 0000000..e6e45ad
--- /dev/null
+++ b/cmake-modules/AzureHonorCxxStandard.cmake
@@ -0,0 +1,16 @@
+# Honor CMAKE_CXX_STANDARD from -D / the parent directory. Azure otherwise
+# `set(CMAKE_CXX_STANDARD 14)` after every project(), which on GCC 12 matches
+# the compiler default stamped by enable_language() and ignores
+# -DCMAKE_CXX_STANDARD=17.
+#
+# Must be included *before* project() in each CMakeLists that would otherwise
+# force 14.
+if(NOT CMAKE_CXX_STANDARD)
+  set(CMAKE_CXX_STANDARD 14)
+endif()
+# Copy cache into a normal variable so project()/enable_language() cannot
+# replace it with the compiler default.
+set(CMAKE_CXX_STANDARD "${CMAKE_CXX_STANDARD}")
+set(CMAKE_CXX_STANDARD "${CMAKE_CXX_STANDARD}" CACHE STRING "C++ standard" FORCE)
+set(CMAKE_CXX_STANDARD_REQUIRED True)
+message(STATUS "AzureHonorCxxStandard: CMAKE_CXX_STANDARD=${CMAKE_CXX_STANDARD} (${CMAKE_CURRENT_SOURCE_DIR})")
